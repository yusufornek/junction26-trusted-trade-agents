# Valio Aimo mock API (Junction 2026 — Trusted Trade Agents)
VALIO_API_BASE=https://junction26.valioaimo.fi
VALIO_API_KEY=            # from the challenge brief; header X-API-Key
VALIO_PORTAL_PASSWORD=    # resource portal login (/docs, /files)

# OpenAI Decisions API (fuzzy product-fit / substitution decisions)
OPENAI_API_KEY=

# Generate operator-issued credentials: backend/.venv/bin/python backend/scripts/gen_keys.py --write
AGENT_KEYS=              # comma-separated agent-id:secret pairs; never publish these
OPERATOR_TOKEN=          # required for API startup and operator console sign-in
OPERATOR_AGENT_ID=web-console  # operator buyer actions use this agent's mandate

ANCHOR_RPC_URL=
ANCHOR_CHAIN_ID=
ANCHOR_PRIVATE_KEY=
ANCHOR_EXPLORER_TX_URL=
ANCHOR_EVERY_N_ENTRIES=

WEBHOOK_SANDBOX=

GATEWAY_ENVIRONMENT=
MCP_AGENT_ID=
GATEWAY_PUBLIC_URL=
AGENT_SECRET=
SUPPLIER_AGENT_KEY=
