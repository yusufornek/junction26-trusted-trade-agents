# Runtime loads these from the REPO ROOT .env.local, not this file.
# Existing process environment variables take precedence. Never commit real keys.
VALIO_API_BASE=https://junction26.valioaimo.fi
VALIO_API_KEY=
OPENAI_API_KEY=
AGENT_KEYS=              # comma-separated agent-id:secret pairs, generated by scripts/gen_keys.py --write
OPERATOR_TOKEN=          # required by the REST API; operator console password field
OPERATOR_AGENT_ID=web-console
