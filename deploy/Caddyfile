{$SITE_ADDRESS::80} {
    @gateway path /v1 /v1/* /health /.well-known/* /oauth/* /mcp* /a2a* /developers* /llms.txt /docs /docs/* /openapi.json
    handle @gateway {
        reverse_proxy backend:8000 {
            # Flush streaming MCP/A2A responses immediately; preserve request paths.
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# Local-only probe serves the built console without DNS, TLS or upstream calls.
http://127.0.0.1:8080 {
    bind 127.0.0.1
    root * /srv
    file_server
}
